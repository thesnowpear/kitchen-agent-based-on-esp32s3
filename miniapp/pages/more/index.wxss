/* 更多页：2×2 网格，与 ui-reference 的 .more-grid 同构 */

.more-page {
  padding-bottom: 310rpx;  /* 给 fixed dock 和中间抬起按钮留出滚动安全区 */
}

.more-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-5);
  margin-top: var(--space-4);
}

.more-card {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: var(--space-4);
  padding: var(--space-6) var(--space-6) var(--space-6);
  min-height: 260rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(180deg, rgba(255, 253, 248, 0.96), rgba(255, 245, 229, 0.92));
  border: 1rpx solid var(--color-line);
  box-shadow: var(--shadow-card);
}

.more-card-hover {
  background: linear-gradient(180deg, rgba(255, 245, 229, 0.98), rgba(234, 245, 223, 0.92));
}

.more-title {
  font-size: var(--text-lg);
  font-weight: 800;
  color: var(--color-ink);
  letter-spacing: -0.3rpx;
}

.more-hint {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: 1.5;
}

.more-badge {
  position: absolute;
  top: var(--space-4);
  right: var(--space-4);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  background: var(--color-yolk-soft);
  color: #946100;
  font-size: var(--text-xs);
  font-weight: 800;
  letter-spacing: 1rpx;
}
