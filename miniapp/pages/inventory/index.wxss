/* inventory 页：zone tab + 九宫格 grid-board + 待归位 list
 * 与 ui-reference 的 .grid-board 对齐：
 *   - 整体一张大圆角卡片，内部 3×3 单元用 1rpx 内分隔线（不是每个 cell 都自己描边）；
 *   - 单格左对齐，左上角是 slot-code（A1 / B2 …），中间放食材 + 数量；
 *   - 临期态用底色 + 右下角胶囊，不是单独描边；
 *   - 选中态 inset 边框 + 米黄底，与 .slot.is-selected 一致。 */

.inventory-page {
  padding-bottom: 160rpx;
}

/* zone tabs：横向滚动胶囊 */
.zone-tabs {
  white-space: nowrap;
  margin: var(--space-3) 0 var(--space-2);
  padding-bottom: var(--space-2);
}
.zone-tabs .tab {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: var(--space-3);
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.6);
  border: 1rpx solid var(--color-line);
  color: var(--color-text-muted);
  font-size: var(--text-sm);
}
.zone-tabs .tab.active {
  background: var(--color-sage-dark);
  color: var(--color-paper);
  border-color: transparent;
  font-weight: 700;
}

/* 九宫格：整张卡 + 内部 3 列 3 行；border 用 box-shadow inset 写出最后一列/行不带分隔。 */
.grid-board {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(3, 1fr);
  min-height: 720rpx;
  overflow: hidden;
  border: 2rpx solid var(--color-line);
  border-radius: var(--radius-lg);
  background:
    linear-gradient(180deg, rgba(255, 253, 248, 0.94), rgba(255, 245, 229, 0.92));
  box-shadow: var(--shadow-card);
}

.cell {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: stretch;
  padding: var(--space-4) var(--space-4) var(--space-3);
  border: 0;
  border-right: 1rpx solid var(--color-line);
  border-bottom: 1rpx solid var(--color-line);
  background: transparent;
  text-align: left;
  overflow: hidden;
  min-height: 220rpx;
}
.cell:nth-child(3n) { border-right: 0; }
.cell:nth-last-child(-n + 3) { border-bottom: 0; }

/* 占用态：底色微亮 + 内阴影模仿 ui-reference 的卡片感 */
.cell.occupied {
  background: rgba(234, 245, 223, 0.42);
}
.cell.warn {
  background: linear-gradient(180deg, rgba(255, 240, 208, 0.88), rgba(255, 253, 248, 0.95));
}
.cell.danger {
  background: linear-gradient(180deg, rgba(255, 229, 223, 0.92), rgba(255, 253, 248, 0.95));
  box-shadow: inset 0 0 0 4rpx rgba(217, 87, 69, 0.18);
}

/* 头部：slot 编码（A1 / B2），ui-reference 用 sage-dark 字 */
.cell-slot {
  font-size: var(--text-xs);
  color: var(--color-sage-dark);
  font-weight: 800;
  letter-spacing: 2rpx;
}

.cell-name {
  font-size: var(--text-md);
  font-weight: 800;
  color: var(--color-ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-top: var(--space-2);
  letter-spacing: -0.2rpx;
}

.cell-meta {
  font-size: var(--text-xs);
  color: var(--color-sage-dark);
  font-weight: 700;
}

/* 临期胶囊：跟 ui-reference .slot-expire 一致 —— 底色 yolk-soft + 棕色字。 */
.cell-expire {
  align-self: flex-start;
  margin-top: var(--space-2);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 240, 208, 0.84);
  color: #8a5d00;
  font-size: var(--text-xs);
  font-weight: 700;
}
.cell.danger .cell-expire {
  background: var(--color-tomato);
  color: #fff;
}
.cell.normal .cell-expire { display: none; }

/* 空格："+" 居中，提示用户可以这里入库 */
.cell.empty .cell-plus {
  font-size: 64rpx;
  color: var(--color-text-soft);
  text-align: center;
  align-self: center;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  font-weight: 300;
}
.cell.empty .cell-slot {
  color: var(--color-text-soft);
  opacity: 0.6;
}

.item-card {
  padding: var(--space-5) var(--space-6);
}