/* settings 页：分块表单 + 切换行 */

.switch-row {
  padding: var(--space-4) 0;
  border-bottom: 1rpx dashed var(--color-line);
}
.switch-row:last-of-type { border-bottom: 0; }

.field-block {
  margin-top: var(--space-4);
}
.field-label {
  color: var(--color-text-muted);
  font-size: var(--text-xs);
  letter-spacing: 1rpx;
  margin-bottom: var(--space-2);
}

/* settings 是 tabBar 页，需要给 fixed dock 和中间抬起按钮留足滚动安全区。 */
.settings-page {
  padding-bottom: 310rpx;
}

.zone-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  margin-top: var(--space-4);
}

.zone-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  padding: var(--space-4);
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.56);
  border: 1rpx solid var(--color-line);
}

.zone-name {
  color: var(--color-ink);
  font-size: var(--text-sm);
  font-weight: 800;
}

.danger-pill {
  color: var(--color-tomato);
  border-color: rgba(217, 87, 69, 0.28);
  background: var(--color-tomato-soft);
}

.field-hint {
  margin-top: var(--space-2);
  font-size: var(--text-xs);
  line-height: 1.5;
}

.textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 180rpx;
  padding: var(--space-4) var(--space-6);
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.7);
  color: var(--color-ink);
  font-size: var(--text-sm);
  line-height: 1.55;
}

.ai-alert {
  margin-top: var(--space-4);
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius-sm);
  background: var(--color-tomato-soft);
  color: var(--color-tomato);
  font-size: var(--text-xs);
  line-height: 1.5;
}

.ai-backend-box {
  margin-top: var(--space-5);
  padding: var(--space-4);
  border: 1rpx dashed var(--color-line-strong);
  border-radius: var(--radius-md);
  background: rgba(255, 241, 208, 0.46);
}

.voice-config-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  margin-top: var(--space-5);
}

.voice-config-box {
  padding: var(--space-4);
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.42);
}

.mini-btn {
  width: 100%;
  height: 68rpx;
  line-height: 68rpx;
  margin-top: var(--space-3);
  font-size: var(--text-sm);
}

.danger-text {
  color: var(--color-tomato);
}
