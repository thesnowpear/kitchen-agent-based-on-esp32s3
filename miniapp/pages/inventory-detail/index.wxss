/* inventory-detail 页：表单字段块 + 参考原型的位置选择链路 */

.field-block {
  margin-top: var(--space-4);
}
.field-block:first-child {
  margin-top: 0;
}
.field-label {
  color: var(--color-text-muted);
  font-size: var(--text-xs);
  letter-spacing: 1rpx;
  margin-bottom: var(--space-2);
}

.food-form-panel {
  padding-top: var(--space-5);
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-4) var(--space-3);
}

.form-grid .field-block {
  margin-top: 0;
}

.form-grid .wide {
  grid-column: 1 / -1;
}

.amount-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 128rpx;
  gap: var(--space-2);
}

.amount-input,
.unit-input {
  min-width: 0;
}

.input-display {
  display: flex;
  align-items: center;
}

.textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 180rpx;
  padding: var(--space-4) var(--space-5);
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.72);
  color: var(--color-ink);
  font-size: var(--text-base);
  font-weight: 700;
  line-height: 1.55;
}

.action-row {
  gap: var(--space-3);
  margin-top: var(--space-3);
  padding-bottom: env(safe-area-inset-bottom);
}

.delete-btn {
  flex: 1;
  min-width: 0;
  background: var(--color-tomato);
  color: #ffffff;
  border: 0;
}

.delete-btn::after {
  border: none;
}

.place-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 56rpx;
  align-items: center;
  gap: var(--space-2);
  margin-top: var(--space-3);
}

.place-input {
  box-sizing: border-box;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 var(--space-6);
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.72);
  color: var(--color-ink);
  font-size: var(--text-base);
  font-weight: 800;
}

.place-edit-row .place-input {
  margin-top: 0;
}

.place-arrow {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-pill);
  background: var(--color-sage-soft);
  color: var(--color-sage-dark);
  font-size: 44rpx;
  line-height: 1;
  font-weight: 900;
}

.place-help {
  margin-top: var(--space-3);
  font-size: var(--text-xs);
}

.place-select-panel {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.place-mode-hint {
  box-sizing: border-box;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  padding: var(--space-3) var(--space-5);
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-md);
  background: var(--color-sage-soft);
  color: var(--color-sage-dark);
  font-size: var(--text-sm);
  font-weight: 900;
}

.place-slot.is-selected {
  border-color: rgba(47, 96, 71, 0.46);
  box-shadow: inset 0 0 0 4rpx rgba(47, 96, 71, 0.14);
}

.place-grid-board {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-3);
}

.place-slot {
  box-sizing: border-box;
  min-height: 180rpx;
  padding: var(--space-3);
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  background: rgba(255, 255, 255, 0.76);
  color: var(--color-ink);
}

.slot-code {
  color: var(--color-sage-dark);
  font-size: var(--text-xs);
  font-weight: 900;
}

.slot-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 4rpx;
}

.slot-food {
  font-size: var(--text-sm);
  font-weight: 900;
  line-height: 1.25;
}

.slot-amount,
.slot-expire {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  line-height: 1.25;
}

.slot-expire {
  color: var(--color-text-soft);
}

.place-action-row {
  gap: var(--space-3);
  margin-top: var(--space-2);
}

.place-action {
  flex: 1;
  min-width: 0;
  padding: 0 var(--space-3);
}

/* 大位置选择复用首页冰箱分区图：保持门架竖列、冷冻横跨、左右冷藏并排。 */
.fridge-map {
  position: relative;
  box-sizing: border-box;
  height: 640rpx;
  display: grid;
  grid-template-columns: 1fr 1fr 0.58fr;
  grid-template-rows: 158rpx 1fr 1fr;
  gap: 16rpx;
  padding: 34rpx 34rpx 38rpx;
  border-radius: 76rpx 76rpx 88rpx 88rpx;
  background:
    radial-gradient(circle at 50% 6%, rgba(255, 255, 255, 0.96), transparent 24%),
    linear-gradient(180deg, #fbfdf9 0%, #eef4ed 52%, #e2ebe2 100%);
  border: 8rpx solid rgba(230, 236, 227, 0.98);
  box-shadow:
    inset 0 0 0 4rpx rgba(83, 106, 93, 0.16),
    inset 0 0 0 15rpx rgba(255, 255, 255, 0.68),
    inset 0 -26rpx 48rpx rgba(74, 86, 66, 0.14),
    0 18rpx 34rpx rgba(74, 86, 66, 0.13);
}

.fridge-map.has-custom-zones {
  height: auto;
  min-height: 980rpx;
  grid-template-rows: 158rpx 206rpx 206rpx;
  grid-auto-rows: 192rpx;
  padding-bottom: 48rpx;
  align-content: start;
}

.zone {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  min-height: 0;
  padding: 24rpx;
  border: 1rpx solid rgba(91, 116, 103, 0.18);
  border-radius: 44rpx;
  color: var(--color-ink);
  text-align: center;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(244, 249, 244, 0.76));
  box-shadow:
    inset 0 0 0 8rpx rgba(255, 255, 255, 0.56),
    inset 0 -28rpx 48rpx rgba(74, 86, 66, 0.05),
    0 12rpx 24rpx rgba(74, 86, 66, 0.04);
  overflow: hidden;
}

.zone-freezer {
  grid-column: 1 / span 2;
  grid-row: 1;
  background: var(--zone-freezer);
}
.zone-freezer .zone-label { color: var(--zone-freezer-ink); }

.zone-left {
  grid-column: 1;
  grid-row: 2 / span 2;
  background: var(--zone-left);
  min-height: 280rpx;
}
.zone-left .zone-label { color: var(--zone-left-ink); }

.zone-right {
  grid-column: 2;
  grid-row: 2 / span 2;
  background: var(--zone-right);
  min-height: 280rpx;
}
.zone-right .zone-label { color: var(--zone-right-ink); }

.zone-door {
  grid-column: 3;
  grid-row: 1 / span 3;
  background: var(--zone-door);
  min-height: 0;
}
.zone-door .zone-label { color: var(--zone-door-ink); }

.zone-label {
  font-size: var(--text-md);
  font-weight: 900;
  line-height: 1.25;
  letter-spacing: 0;
}

.zone-strong {
  font-size: var(--text-sm);
  font-weight: 900;
  color: rgba(36, 52, 45, 0.74);
  line-height: 1.3;
}

.zone-freezer::after,
.zone-left::after,
.zone-right::after,
.zone-door::after {
  content: "→";
  position: absolute;
  right: 22rpx;
  top: 22rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--text-md);
  color: rgba(36, 52, 45, 0.62);
}

.zone-custom {
  min-height: 172rpx;
  background: #fff8e7;
}

.zone.is-selected {
  outline: 6rpx solid rgba(47, 96, 71, 0.28);
  box-shadow:
    inset 0 0 0 8rpx rgba(255, 255, 255, 0.56),
    0 0 0 12rpx rgba(47, 96, 71, 0.08);
}

.zone-custom .zone-strong {
  font-size: var(--text-xs);
  color: rgba(36, 52, 45, 0.68);
}

.zone-custom.span-w2-h1 { grid-column: span 2; }
.zone-custom.span-w3-h1 { grid-column: span 3; }
.zone-custom.span-w1-h2 { grid-row: span 2; }
.zone-custom.span-w1-h3 { grid-row: span 3; }
.zone-custom.span-w2-h2 {
  grid-column: span 2;
  grid-row: span 2;
}
.zone-custom.span-w2-h3 {
  grid-column: span 2;
  grid-row: span 3;
}
.zone-custom.span-w3-h2 {
  grid-column: span 3;
  grid-row: span 2;
}
.zone-custom.span-w3-h3 {
  grid-column: span 3;
  grid-row: span 3;
}
