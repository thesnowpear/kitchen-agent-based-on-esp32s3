<view class="page rise">
  <view class="hello-bar">
    <view class="col">
      <view class="kicker">{{mode === 'create' ? '新增条目' : '编辑条目'}}</view>
      <view class="title">{{mode === 'create' ? '入库登记' : name}}</view>
    </view>
  </view>

  <view wx:if="{{errorText}}" class="panel" style="border-color: var(--color-tomato-soft);">
    <view class="kicker" style="color: var(--color-tomato);">{{errorText}}</view>
  </view>

  <view wx:if="{{placeMode === 'form'}}" class="panel food-form-panel">
    <view class="form-grid">
      <view class="field-block">
        <view class="field-label">食材名称 *</view>
        <input class="input" value="{{name}}" placeholder="例如 番茄" data-field="name" bindinput="onFieldInput" />
      </view>
      <view class="field-block">
        <view class="field-label">数量</view>
        <view class="amount-row">
          <input class="input amount-input" type="digit" value="{{quantity}}" data-field="quantity" bindinput="onFieldInput" />
          <input class="input unit-input" value="{{unit}}" placeholder="个" data-field="unit" bindinput="onFieldInput" />
        </view>
      </view>
      <view class="field-block">
        <view class="field-label">到期时间</view>
        <picker mode="date" value="{{expireDate}}" bindchange="onDateChange">
          <view class="input input-display">{{expireDate || '未设置'}}</view>
        </picker>
      </view>
      <view class="field-block">
        <view class="field-label">位置</view>
        <view class="place-edit-row">
          <view class="place-input" bindtap="beginPlaceSelection">{{placeText}}</view>
        </view>
      </view>
      <view class="field-block">
        <view class="field-label">放入时间</view>
        <input class="input" value="{{storedAt}}" placeholder="YYYY-MM-DD HH:mm" data-field="storedAt" bindinput="onFieldInput" />
      </view>
      <view class="field-block">
        <view class="field-label">类别</view>
        <input class="input" value="{{category}}" placeholder="蔬菜 / 肉类 / 调料 …" data-field="category" bindinput="onFieldInput" />
      </view>
      <view class="field-block wide">
        <view class="field-label">备注</view>
        <textarea class="textarea" value="{{note}}" placeholder="例如：来自左侧冷藏 B2，2 个。" data-field="note" bindinput="onFieldInput" />
      </view>
    </view>
  </view>

  <block wx:if="{{placeMode === 'zone'}}">
    <view class="panel place-select-panel">
      <view class="place-mode-hint">正在选择食材位置：先点击一个冰箱空间</view>
      <view class="fridge-map place-fridge-map {{zoneOptions.length > 5 ? 'has-custom-zones' : ''}}">
        <block wx:for="{{zoneOptions}}" wx:key="value">
          <view
            wx:if="{{item.value}}"
            class="zone {{item.zoneClass}} {{item.spanClass}} {{item.value === selectedZoneValue ? 'is-selected' : ''}}"
            data-value="{{item.value}}"
            bindtap="onTapPlaceZone"
          >
            <text class="zone-label">{{item.label}}</text>
            <text class="zone-strong">{{item.count}} 件</text>
          </view>
        </block>
      </view>
      <view class="row place-action-row">
        <button class="btn ghost place-action" bindtap="cancelPlaceSelection">取消</button>
        <button class="btn secondary place-action" bindtap="onClearPlace">清空位置</button>
      </view>
    </view>
  </block>

  <block wx:elif="{{placeMode === 'slot'}}">
    <view class="panel place-select-panel">
      <view class="place-mode-hint">已选择 {{choosingZoneLabel}}，再点击一个格位</view>
      <view class="place-grid-board">
        <view
          wx:for="{{slotOptions}}"
          wx:key="value"
          class="place-slot {{item.value === selectedSlotValue && choosingZoneIndex === zoneIndex ? 'is-selected' : ''}}"
          data-value="{{item.value}}"
          bindtap="onTapPlaceSlot"
        >
          <view class="slot-code">{{item.shortLabel}}</view>
          <view class="slot-main">
            <view class="slot-food">空位</view>
            <view class="slot-amount">点击放入</view>
          </view>
          <view class="slot-expire">位置 {{item.label}}</view>
        </view>
      </view>
      <view class="row place-action-row">
        <button class="btn ghost place-action" bindtap="backToPlaceZones">重选空间</button>
        <button class="btn secondary place-action" bindtap="cancelPlaceSelection">取消</button>
      </view>
    </view>
  </block>

  <view wx:if="{{placeMode === 'form'}}" class="row action-row">
    <button wx:if="{{mode === 'edit'}}" class="btn delete-btn" bindtap="onDelete">删除</button>
    <button class="btn" style="flex: 2;" loading="{{saving}}" bindtap="onSave">{{mode === 'create' ? '入库' : '保存'}}</button>
  </view>
</view>
