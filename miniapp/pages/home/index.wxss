/* home 页样式：与 ui-reference/WLW/styles.css 的 app-status / home-head / fridge-map / dock 保持一致。
 * 重点：
 *   - app-status 是顶部状态条，不是 panel；高度 96rpx 左右；
 *   - home-head 不再用 panel 包，直接堆 kicker + h2 + pill-row；
 *   - fridge-map 用三列网格，"上层冷冻"跨 col1+col2，"门架"跨整个 col3 三行；
 *   - 给底部留 220rpx 空间避免被 ai-fab + tabBar 遮住；
 *   - status-panel 是底部抽屉，半透明 mask 全屏覆盖。
 */

.home-page {
  padding-top: var(--space-3);
  /* 给 fixed dock + 中间抬起按钮留出安全区，避免最后内容被导航遮挡。 */
  padding-bottom: 310rpx;
  gap: var(--space-5);
}

/* ---------- 顶部状态条 ---------- */

.app-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-3) var(--space-5);
  background: rgba(255, 253, 248, 0.7);
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-pill);
  box-shadow: 0 4rpx 18rpx rgba(74, 86, 66, 0.06);
}

.app-status .brand {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}
.app-status .mascot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-yolk-soft);
  color: var(--color-sage-dark);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
}
.app-status .brand-name {
  font-size: var(--text-sm);
  color: var(--color-sage-dark);
  font-weight: 700;
  letter-spacing: 1rpx;
}
.app-status .clock {
  font-size: var(--text-base);
  color: var(--color-ink);
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

/* 设备小圆点：online 绿 / offline 红 / 未知 黄 */
.device-pill {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: 6rpx 18rpx;
  border-radius: var(--radius-pill);
  background: var(--color-paper-soft);
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  border: 1rpx solid var(--color-line);
}
.device-pill .device-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-text-soft);
}
.device-pill.online {
  background: var(--color-sage-soft);
  color: var(--color-sage-dark);
  border-color: rgba(47, 96, 71, 0.28);
}
.device-pill.online .device-dot { background: var(--color-sage-dark); }
.device-pill.offline {
  background: var(--color-tomato-soft);
  color: var(--color-tomato);
  border-color: rgba(217, 87, 69, 0.28);
}
.device-pill.offline .device-dot { background: var(--color-tomato); }
.device-pill.warn {
  background: var(--color-yolk-soft);
  color: #946100;
  border-color: rgba(246, 191, 79, 0.5);
}
.device-pill.warn .device-dot { background: var(--color-yolk); }

/* ---------- 问候 + 主标题 ---------- */

.home-head {
  padding: 0 var(--space-2);
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}
.home-head .h2 {
  margin: 0;
  font-size: var(--text-xl);
  font-weight: 800;
  color: var(--color-ink);
  letter-spacing: -0.5rpx;
}
.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
  margin-top: var(--space-2);
}
.pill.warn {
  background: var(--color-tomato-soft);
  color: var(--color-tomato);
  border-color: rgba(217, 87, 69, 0.32);
}

/* 未绑定时的引导面板 */
.bind-prompt {
  background:
    radial-gradient(circle at 90% 0%, rgba(246, 191, 79, 0.18), transparent 40%),
    linear-gradient(180deg, rgba(255, 253, 248, 0.96), rgba(255, 245, 229, 0.94));
}

/* ---------- 数字行 ---------- */

.stat-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-3);
  padding: var(--space-5) var(--space-4);
  background:
    linear-gradient(180deg, rgba(255, 253, 248, 0.96), rgba(255, 245, 229, 0.94));
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}
.stat {
  text-align: center;
}
.stat-num {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--color-sage-dark);
  letter-spacing: -1rpx;
  line-height: 1.05;
}
.stat-num.danger { color: var(--color-tomato); }
.stat-label {
  margin-top: var(--space-2);
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  letter-spacing: 1rpx;
}

/* ---------- 冰箱分布图（核心：与 ui-reference fridge-map 对齐） ---------- */

.fridge-kicker {
  padding: 0 var(--space-2);
}

.fridge-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  margin-top: var(--space-2);
}

.edit-pill.active {
  background: var(--color-sage-dark);
  color: #fff;
  border-color: transparent;
}

.fridge-map {
  position: relative;
  box-sizing: border-box;
  height: 640rpx;
  display: grid;
  grid-template-columns: 1fr 1fr 0.58fr;
  grid-template-rows: 158rpx 1fr 1fr;
  gap: 16rpx;
  padding: 34rpx 34rpx 38rpx;
  border-radius: 76rpx 76rpx 88rpx 88rpx;
  background:
    radial-gradient(circle at 50% 6%, rgba(255, 255, 255, 0.96), transparent 24%),
    linear-gradient(180deg, #fbfdf9 0%, #eef4ed 52%, #e2ebe2 100%);
  border: 8rpx solid rgba(230, 236, 227, 0.98);
  box-shadow:
    inset 0 0 0 4rpx rgba(83, 106, 93, 0.16),
    inset 0 0 0 15rpx rgba(255, 255, 255, 0.68),
    inset 0 -26rpx 48rpx rgba(74, 86, 66, 0.14),
    0 18rpx 34rpx rgba(74, 86, 66, 0.13);
}

.fridge-map.is-space-editing,
.fridge-map.has-custom-zones {
  height: auto;
  min-height: 980rpx;
  grid-template-rows: 158rpx 206rpx 206rpx;
  grid-auto-rows: 192rpx;
  padding-bottom: 48rpx;
  align-content: start;
}

.zone {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  min-height: 0;
  padding: 24rpx;
  border: 1rpx solid rgba(91, 116, 103, 0.18);
  border-radius: 44rpx;
  color: var(--color-ink);
  text-align: center;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(244, 249, 244, 0.76));
  box-shadow:
    inset 0 0 0 8rpx rgba(255, 255, 255, 0.56),
    inset 0 -28rpx 48rpx rgba(74, 86, 66, 0.05),
    0 12rpx 24rpx rgba(74, 86, 66, 0.04);
  overflow: hidden;
}

.zone-freezer {
  grid-column: 1 / span 2;
  grid-row: 1;
  background: var(--zone-freezer);
}
.zone-freezer .zone-label { color: var(--zone-freezer-ink); }

.zone-left {
  grid-column: 1;
  grid-row: 2 / span 2;
  background: var(--zone-left);
  min-height: 280rpx;
}
.zone-left .zone-label { color: var(--zone-left-ink); }

.zone-right {
  grid-column: 2;
  grid-row: 2 / span 2;
  background: var(--zone-right);
  min-height: 280rpx;
}
.zone-right .zone-label { color: var(--zone-right-ink); }

.zone-door {
  grid-column: 3;
  grid-row: 1 / span 3;
  background: var(--zone-door);
  min-height: 0;
}
.zone-door .zone-label { color: var(--zone-door-ink); }

.zone-label {
  font-size: var(--text-md);
  font-weight: 900;
  line-height: 1.25;
  letter-spacing: 0;
}

.zone-strong {
  font-size: var(--text-sm);
  font-weight: 900;
  color: var(--color-ink);
  line-height: 1.3;
}

.zone-freezer .zone-strong,
.zone-left .zone-strong,
.zone-right .zone-strong,
.zone-door .zone-strong {
  color: rgba(36, 52, 45, 0.74);
}

.zone-freezer::after,
.zone-left::after,
.zone-right::after,
.zone-door::after {
  content: "→";
  position: absolute;
  right: 22rpx;
  top: 22rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--text-md);
  color: rgba(36, 52, 45, 0.62);
}

.zone-add {
  display: none;
  min-height: 172rpx;
  border-style: dashed;
  background: rgba(255, 255, 255, 0.52);
}

.fridge-map.is-space-editing .zone-add {
  display: flex;
  grid-column: span 1;
  grid-row: span 1;
}

.zone-custom {
  min-height: 172rpx;
  background: #fff8e7;
}

.zone-custom.is-edit-target {
  outline: 6rpx solid rgba(217, 87, 69, 0.36);
  box-shadow: 0 0 0 12rpx rgba(217, 87, 69, 0.08);
}

.zone-custom .zone-strong {
  font-size: var(--text-xs);
  color: rgba(36, 52, 45, 0.68);
}

.zone.is-edit-target {
  outline: 6rpx solid rgba(217, 87, 69, 0.36);
  box-shadow: 0 0 0 12rpx rgba(217, 87, 69, 0.08);
}

.zone-custom.span-w2-h1 { grid-column: span 2; }
.zone-custom.span-w3-h1 { grid-column: span 3; }
.zone-custom.span-w1-h2 { grid-row: span 2; }
.zone-custom.span-w1-h3 { grid-row: span 3; }
.zone-custom.span-w2-h2 {
  grid-column: span 2;
  grid-row: span 2;
}
.zone-custom.span-w2-h3 {
  grid-column: span 2;
  grid-row: span 3;
}
.zone-custom.span-w3-h2 {
  grid-column: span 3;
  grid-row: span 2;
}
.zone-custom.span-w3-h3 {
  grid-column: span 3;
  grid-row: span 3;
}

.space-editor {
  display: none;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 40rpx;
  border: 1rpx solid var(--color-line);
  background: rgba(255, 255, 255, 0.72);
}

.space-editor.is-open {
  display: grid;
}

.space-editor label {
  display: grid;
  gap: 10rpx;
  color: var(--color-sage-dark);
  font-size: var(--text-xs);
  font-weight: 900;
}

.space-editor input {
  box-sizing: border-box;
  min-height: 84rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-line);
  background: rgba(255, 255, 255, 0.88);
  color: var(--color-ink);
  font-size: var(--text-sm);
  font-weight: 900;
}

.space-editor slider {
  min-height: 68rpx;
}

.space-note,
.space-delete {
  grid-column: 1 / -1;
}

.space-delete {
  min-height: 96rpx;
  line-height: 96rpx;
  padding: 0 28rpx;
  border: 0;
  border-radius: 32rpx;
  background: #fff0d0;
  color: #8a5d00;
  font-size: var(--text-sm);
  font-weight: 900;
}
.space-delete::after { border: none; }

/* ---------- 临期清单 ---------- */

.expiring-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}
.expiring-card {
  padding: var(--space-5) var(--space-6);
}

/* ---------- 设备状态抽屉 ---------- */

.status-mask {
  position: fixed;
  inset: 0;
  background: rgba(36, 52, 45, 0.4);
  z-index: 30;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  animation: fade 160ms ease both;
}
@keyframes fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

.status-panel {
  width: 100%;
  background: var(--color-paper);
  border-top-left-radius: var(--radius-lg);
  border-top-right-radius: var(--radius-lg);
  padding: var(--space-5) var(--space-6) var(--space-10);
  box-shadow: 0 -12rpx 36rpx rgba(74, 86, 66, 0.18);
  animation: slide 180ms ease both;
}
@keyframes slide {
  from { transform: translateY(20rpx); opacity: 0.8; }
  to { transform: translateY(0); opacity: 1; }
}
.status-handle {
  width: 96rpx;
  height: 8rpx;
  background: var(--color-line);
  border-radius: var(--radius-pill);
  margin: 0 auto var(--space-5);
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-3) 0;
  border-bottom: 1rpx solid var(--color-line);
}
.status-row:last-of-type { border-bottom: none; }
.status-row .muted {
  color: var(--color-text-muted);
  font-size: var(--text-sm);
}
.status-row .value {
  color: var(--color-ink);
  font-size: var(--text-sm);
  font-weight: 600;
  text-align: right;
  max-width: 60%;
  word-break: break-all;
}

/* AI fab 已被底部 dock 取代；以下规则保留但页面 wxml 已不渲染该按钮 */
.ai-fab {
  display: none;
}
