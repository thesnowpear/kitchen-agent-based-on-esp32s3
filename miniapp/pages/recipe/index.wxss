/* AI 菜谱页：meal-summary + meal-card 堆叠，对齐 ui-reference */

.recipe-page {
  padding-bottom: 220rpx;  /* 给自定义 tabBar 让位：dock 144 + margin 16 + 抬起 56 */
}

.meal-summary {
  background: linear-gradient(180deg, var(--color-yolk-soft), var(--color-paper-soft));
  border-color: rgba(246, 191, 79, 0.4);
}

.meal-summary-title {
  font-size: var(--text-xl);
  font-weight: 800;
  color: var(--color-ink);
  margin-top: var(--space-2);
  letter-spacing: -0.3rpx;
}

.meal-summary-hint {
  margin-top: var(--space-3);
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: 1.55;
}

.meal-summary-meta {
  margin-top: var(--space-4);
  font-size: var(--text-xs);
  color: var(--color-sage-dark);
  font-weight: 800;
  letter-spacing: 1rpx;
}

.meal-cards {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
  margin-top: var(--space-4);
}

.meal-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  padding: var(--space-6);
  border-radius: var(--radius-lg);
  background: linear-gradient(180deg, rgba(255, 253, 248, 0.96), rgba(255, 245, 229, 0.92));
  border: 1rpx solid var(--color-line);
  box-shadow: var(--shadow-card);
}

.meal-card-hover {
  background: linear-gradient(180deg, rgba(255, 245, 229, 0.98), rgba(234, 245, 223, 0.94));
}

.meal-card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-3);
}

.meal-card-title {
  font-size: var(--text-lg);
  font-weight: 800;
  color: var(--color-ink);
  letter-spacing: -0.2rpx;
}

.meal-card-duration {
  font-size: var(--text-xs);
  color: var(--color-sage-dark);
  font-weight: 800;
  letter-spacing: 1rpx;
}

.meal-card-desc {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: 1.55;
}

.meal-card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
}

.ingredient-line {
  font-size: var(--text-xs);
  color: var(--color-text-soft);
  line-height: 1.5;
}

.add-missing {
  height: 64rpx;
  line-height: 64rpx;
  font-size: var(--text-sm);
  margin-top: var(--space-2);
}

.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 40;
  display: flex;
  align-items: flex-end;
  background: rgba(36, 52, 45, 0.38);
}

.recipe-sheet {
  box-sizing: border-box;
  width: 100%;
  max-height: 86vh;
  overflow-y: auto;
  padding: var(--space-5) var(--space-6) calc(var(--space-8) + env(safe-area-inset-bottom));
  border-top-left-radius: var(--radius-lg);
  border-top-right-radius: var(--radius-lg);
  background: var(--color-paper);
  box-shadow: 0 -16rpx 42rpx rgba(74, 86, 66, 0.2);
}

.sheet-handle {
  width: 96rpx;
  height: 8rpx;
  margin: 0 auto var(--space-5);
  border-radius: var(--radius-pill);
  background: var(--color-line);
}

.sheet-title {
  margin: var(--space-2) 0;
  font-size: var(--text-xl);
  font-weight: 800;
  color: var(--color-ink);
}

.detail-section {
  margin-top: var(--space-6);
}

.ingredient-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-top: var(--space-3);
}

.ingredient {
  display: flex;
  justify-content: space-between;
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.6);
  color: var(--color-ink);
  font-size: var(--text-sm);
}

.ingredient.missing {
  background: var(--color-yolk-soft);
  color: #8a5d00;
}

.step-row {
  display: flex;
  gap: var(--space-3);
  margin-top: var(--space-3);
  color: var(--color-text-muted);
  font-size: var(--text-sm);
  line-height: 1.6;
}

.step-index {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  border-radius: 50%;
  background: var(--color-sage-soft);
  color: var(--color-sage-dark);
  text-align: center;
  font-size: var(--text-xs);
  font-weight: 800;
}

.sheet-actions {
  gap: var(--space-3);
  margin-top: var(--space-6);
}
