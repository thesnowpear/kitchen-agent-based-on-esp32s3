APP_NAME=fridge-spirit-backend
APP_ENV=local
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# 本地 docker compose 用 service 名 `postgres` 作为 host；
# 本地裸 venv 调试时改成 localhost。
DATABASE_URL=postgresql+asyncpg://fridge:fridge_dev_password@postgres:5432/fridge_spirit
AUTO_CREATE_TABLES=true

# 微信公众平台凭证：留空时 wx_auth_service 会返 demo openid（应付比赛 / 开发期）。
# 上线前必须填入真实 APPID / SECRET，并在公众平台配合法域名。
WX_APPID=
WX_SECRET=
WX_CODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session

# MQTT broker：
# - 在 docker compose 内 service 名 `emqx`；
# - 本机裸 venv 调试时改成 localhost；
# - ESP32 设备端 NVS 里的 broker URI 用宿主机局域网 IP（如 mqtt://192.168.x.x:1883），
#   且 home_id / device_id 要与 backend 数据库里 DEMO 家庭/设备一致才能联通。
MQTT_BROKER_HOST=emqx
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=fridge-spirit-backend
# **必须**与设备端 fridge_mqtt_protocol.c 写死的前缀 "fridge" 一致；改了设备消息收不到。
MQTT_TOPIC_PREFIX=fridge
MQTT_KEEPALIVE_SECONDS=60

# JWT：本期使用对称密钥 HS256；生产化必须换非对称 + KMS。
JWT_SECRET=change-me-in-local-dev-with-32-chars-or-more
ACCESS_TOKEN_TTL_SECONDS=604800

# CORS：本地小程序开发者工具不需要，Web 操作面板（5173）和 Nginx 网关（6005）需要。
CORS_ORIGINS=["http://localhost:5173","http://localhost:6005"]

# ====== SiliconFlow / AI ======
# /inventory/scan 视觉识别 + /ai/chat 云端降级都用同一个 base url + api key。
# 未配置 API Key 时这两个接口会返 ApiResponse(ok=False)，不抛 5xx。
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
VISION_MODEL=Qwen/Qwen2-VL-7B-Instruct
CHAT_MODEL=Qwen/Qwen2.5-32B-Instruct
INVENTORY_SCAN_MAX_BYTES=5242880
AI_DEVICE_TIMEOUT_SECONDS=30
